            <% if (ShowForcePasswordChangeModal) { %>
            <div class="modal fade force-password-modal" id="forcePasswordChangeModal" tabindex="-1" aria-labelledby="forcePasswordChangeModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="forcePasswordChangeModalLabel">
                                <i class="fa fa-lock me-2"></i> Password Change Required
                            </h5>
                        </div>
                        <div class="modal-body text-center">
                            <div class="security-icon">
                                <i class="fa fa-shield"></i>
                            </div>
                            <h5 class="mb-2 fw-bold">Please update your password</h5>
                            <p>Your account requires a password update before continuing. This window cannot be closed until the password is changed.</p>
                            <a href="../UserProfile_UI/ChangePassword.aspx" class="btn btn-change-password">
                                <i class="fa fa-refresh me-1"></i> Change Password Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function () {
                    var modalElement = document.getElementById('forcePasswordChangeModal');
                    if (!modalElement || typeof bootstrap === 'undefined') {
                        return;
                    }

                    var modal = new bootstrap.Modal(modalElement, {
                        backdrop: 'static',
                        keyboard: false
                    });

                    modalElement.addEventListener('hide.bs.modal', function (event) {
                        event.preventDefault();
                    });

                    modal.show();
                });
            </script>
            <% } %>

        </form>

